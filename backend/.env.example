# Variáveis de ambiente lidas por config/settings/environment.py (classe
# Environment). Em produção, DJANGO_SECRET_KEY, POSTGRES_PASSWORD e
# RABBITMQ_URL vêm de um Secret do Kubernetes; o resto pode vir de ConfigMap
# (ver docs/ARQUITETURA.md, seção "Configuração e segredos").
#
# Copie para .env e ajuste para rodar localmente. Nenhum destes valores é
# lido automaticamente de um arquivo .env pelo Django puro — exporte-os no
# shell, ou use `django-environ`/`python-dotenv` no `manage.py` local se
# preferir; a classe Environment só olha para os.environ.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=licita
POSTGRES_USER=licita
POSTGRES_PASSWORD=licita
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Ver apps/integracoes e docs/DOMINIO.md. Defaults já são os certos; só
# muda em teste/homolog se o governo trocar de domínio de novo.
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br
PNCP_BASE_URL=https://pncp.gov.br
CATALOGO_SYNC_INTERVALO_SEGUNDOS=0.3
USAR_BUSCA_PNCP=true

JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=30
